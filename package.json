{
  "name": "@rero/sonar-ui",
  "version": "22.0.0",
  "description": "User interface for SONAR.",
  "keywords": [
    "rero",
    "invenio",
    "angular"
  ],
  "homepage": "https://github.com/rero/sonar-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rero/sonar-ui"
  },
  "license": "AGPL-3.0-only",
  "author": {
    "name": "RERO",
    "email": "software@rero.ch"
  },
  "packageManager": "pnpm@12.15.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ng build sonar --configuration production",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack": "./scripts/check-no-local-links.js && pnpm run build && ./scripts/dist_pkg.js -o build && cd build && pnpm pack --pack-destination ..",
    "serve": "ng serve --configuration proxy --no-hmr --ssl true --ssl-cert ./certificate/localhost.crt --ssl-key ./certificate/localhost.key",
    "test": "ng test",
    "extract_messages": "ngx-translate-extract -k -c -s -i ./projects/sonar/src -o ./projects/sonar/translations/messages.json --fi '  '",
    "update_catalog": "ngx-translate-extract -k -c -s -i ./projects/sonar/src -o ./projects/sonar/src/assets/i18n/{de,en,fr,it,es,eo,uk}.json --fi '  '",
    "release": "semantic-release"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@ngrx/signals": "^22.0.1",
    "@ngx-formly/core": "^11.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-locale": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "@rero/ng-core": "^21.3.0",
    "easymde": "^2.21.0",
    "katex": "^0.19.1",
    "lodash-es": "^4.18.1",
    "ngx-spinner": "^22.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@analogjs/vitest-angular": "^2.9.2",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@ngx-formly/schematics": "^11.0.0",
    "@openng/optimus-ui-tailwindcss": "^2.0.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vendure/ngx-translate-extract": "^10.3.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "yargs": "^18.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
